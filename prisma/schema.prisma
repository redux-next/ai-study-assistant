generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String       @id @default(cuid())
  name        String?
  email       String       @unique
  password    String
  avatarUrl   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  chats       Chat[]
  documents   Document[]
  quizResults QuizResult[]
}

model Chat {
  id        String    @id @default(cuid())
  title     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]
}

model Message {
  id        String   @id @default(cuid())
  role      String
  content   String
  createdAt DateTime @default(now())
  chatId    String
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
}

model Document {
  id           String          @id @default(cuid())
  originalName String
  createdAt    DateTime        @default(now())
  fileUrl      String
  filename     String
  status       String          @default("uploaded")
  updatedAt    DateTime        @updatedAt
  userId       String?
  user         User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks       DocumentChunk[]
}

model DocumentChunk {
  id         String   @id @default(cuid())
  documentId String
  content    String
  chunkIndex Int
  createdAt  DateTime @default(now())
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model QuizResult {
  id             String   @id @default(cuid())
  topic          String
  difficulty     String
  score          Int
  totalQuestions Int
  createdAt      DateTime @default(now())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}
